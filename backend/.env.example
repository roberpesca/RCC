# Server
PORT=8080
# Single-user access code required in the "x-access-code" header (or ?code= on the Strava connect link)
ACCESS_CODE=changeme

# Strava API app credentials — create a free app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
# Must match the "Authorization Callback Domain" set in your Strava API app settings
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback

# Where the frontend lives — used to redirect back after Strava OAuth completes
FRONTEND_URL=http://localhost:5173

# SQLite file path (Render/Fly disks: point this at a persistent volume, e.g. /data/coach.db)
DB_PATH=./data/coach.db
